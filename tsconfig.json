{
  "extends": "@scoretravel/tsconfig/tsconfig.base.json",

  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/config/*": ["./src/config/*"],
      "@/routes/*": ["./src/routes/*"],
      "@/styles.css": ["./src/styles-2.css"],
      "@/ui/*": ["./src/components/ui/*"],
      "@/blocks/*": ["./src/components/blocks/*"]
    }
  },
  "exclude": ["dist/", "storybook-static/"]
}
