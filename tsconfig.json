{
  "extends": "@scoretravel/tsconfig/tsconfig.base.json",

  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    // Override base (true) — TanStack requires this off
    // Note: Barrel files and re-exports don't work with verbatimModuleSyntax
    // "verbatimModuleSyntax": false,

    "paths": {
      "@/config/*": ["./src/config/*"],
      "@/routes/*": ["./src/routes/*"],
      "@/styles.css": ["./src/styles.css"],
      "@/ui/*": ["./src/components/ui/*"],
      "@/blocks/*": ["./src/components/blocks/*"]
    }
  },
  "exclude": ["dist/", "storybook-static/"]
}
