{
  "name": "@launchunit/veritact-demo",
  "type": "module",
  "engines": {
    "node": ">=22.10",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "//": "Skipping husky in CI environments",
    "prepare": "if [ -z \"$CI\" ]; then husky; fi",
    "clean": "rimraf -g -v \"**/{node_modules,dist,out,.cache,.vercel,*.tsbuildinfo}\"",
    "build": "TZ=UTC vite build",
    "dev": "TZ=UTC vite --clearScreen=false",
    "format": "prettier --write .",
    "format:check": "prettier --check . || prettier --list-different .",
    "lint": "tsc --noEmit && biome lint",
    "storybook:dev": "storybook dev",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@scoretravel/zod-v4": "^0.1.9",
    "@tabler/icons-react": "^3.37.1",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.3",
    "@scoretravel/prettier-config": "^0.0.19",
    "@scoretravel/test-utils": "^0.1.5",
    "@scoretravel/tsconfig": "^0.0.9",
    "@scoretravel/vite-validate-config": "^0.0.5",
    "@scoretravel/vscode": "^0.1.2",
    "@storybook/react-vite": "^10.2.11",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/react-devtools": "^0.9.6",
    "@tanstack/react-router-devtools": "^1.162.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.6",
    "rimraf": "^6.1.3",
    "storybook": "^10.2.11",
    "type-fest": "^5.4.4",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^4.0.18"
  },
  "prettier": "@scoretravel/prettier-config"
}
